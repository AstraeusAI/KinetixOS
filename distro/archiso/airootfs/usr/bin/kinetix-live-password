#!/usr/bin/env bash
set -Eeuo pipefail

# The root filesystem is ephemeral, so establish a fresh administrator
# credential at each boot before SDDM starts. Passwords are read without
# echo and sent to chpasswd over stdin; they never appear in argv or logs.
exec </dev/tty1 >/dev/tty1 2>&1

while true; do
    printf '\nKinetixOS live session setup\n'
    printf 'Set an administrator password (at least 12 characters): '
    IFS= read -r -s password || exit 1
    printf '\nConfirm administrator password: '
    IFS= read -r -s confirmation || exit 1
    printf '\n'

    if (( ${#password} < 12 )); then
        printf 'Use at least 12 characters. Please try again.\n'
        unset password confirmation
        continue
    fi
    if [[ "$password" != "$confirmation" ]]; then
        printf 'The passwords did not match. Please try again.\n'
        unset password confirmation
        continue
    fi

    if printf 'kinetix:%s\n' "$password" | /usr/bin/chpasswd; then
        unset password confirmation
        printf '\nPassword set. Starting the desktop…\n'
        exit 0
    fi
    unset password confirmation
    printf 'Could not set the password. Please try again.\n'
done
