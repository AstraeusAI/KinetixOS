#!/usr/bin/env bash
set -euo pipefail

# Use standalone Kinetix landscape artwork inspired by the reference. The
# original screenshot remains reference-only so its mockup bar/dock/widgets do
# not duplicate the real Quickshell surfaces.
export KINETIX_WALLPAPER="${KINETIX_WALLPAPER:-/usr/share/backgrounds/kinetixos/wallpaper.png}"
/usr/bin/swaybg -i "$KINETIX_WALLPAPER" -m fill &
wallpaper_pid=$!
trap 'kill "$wallpaper_pid" 2>/dev/null || true' EXIT

# The desktop shows the desktop folder live (shell/desktop/DesktopIcons.qml);
# make sure it exists first, or there is nothing to watch on a fresh account.
desktop_dir="$(xdg-user-dir DESKTOP 2>/dev/null || true)"
mkdir -p -- "${desktop_dir:-$HOME/Desktop}"

/usr/bin/quickshell -p /usr/share/kinetix/shell "$@"
