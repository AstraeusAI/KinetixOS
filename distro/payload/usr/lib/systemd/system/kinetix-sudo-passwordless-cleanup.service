[Unit]
Description=Revoke any temporary passwordless sudo grant left from the last boot
# The auto-expiry timer is a transient systemd unit, which lives in memory and
# is gone after a reboot — so a grant that outlived a crash or a power cut
# would otherwise survive forever. This is the other half of the promise: a
# restart always clears it.
ConditionPathExists=/etc/sudoers.d/99-kinetix-passwordless
After=local-fs.target
Before=multi-user.target

[Service]
Type=oneshot
ExecStart=/usr/bin/kinetix-sudo-passwordless off

[Install]
WantedBy=multi-user.target
