#!/usr/bin/env bash
# kinetix-sudo-passwordless — grant NOPASSWD sudo for a bounded window.
#
# The agent runs long, root-touching stretches of work, and typing a password
# into every one of them is the friction that pushes people to a permanent
# NOPASSWD rule — which is strictly worse, because it never expires and
# survives reboots. This is the bounded version of the same convenience: the
# grant is written, a timer is armed to delete it, and a boot-time cleanup
# removes it early if the machine restarts first.
#
# While it is on, anything running as this user can become root without being
# asked. That is the entire point and the entire risk, so:
#   - the window is capped (MAX_MINUTES) and defaults low
#   - it is always paired with an automatic revoke, never left open
#   - the file is written only after `visudo -c` confirms it is valid, so a
#     syntax error can never lock sudo out
set -Eeuo pipefail

CALLER="${SUDO_USER:-${USER:-$(id -un)}}"
SUDOERS_DIR="${KINETIX_SUDOERS_DIR:-/etc/sudoers.d}"
STATE_DIR="${KINETIX_STATE_DIR:-/var/lib/kinetix}"
DROPIN="$SUDOERS_DIR/99-kinetix-passwordless"
MAX_MINUTES=1440

die() { printf 'kinetix-sudo-passwordless: %s\n' "$*" >&2; exit 1; }

revoke() {
    rm -f -- "$DROPIN"
    rm -f -- "$STATE_DIR/passwordless-since" 2>/dev/null || true
    printf 'Passwordless sudo revoked.\n'
}

case "${1:-}" in
    -h|--help|help)
        printf 'usage: kinetix sudo-passwordless [MINUTES]\n'
        printf '       kinetix sudo-passwordless off\n'
        printf 'Grants NOPASSWD sudo to %s for MINUTES (default 15, max %d),\n' "$CALLER" "$MAX_MINUTES"
        printf 'then removes it automatically. `off` ends it early.\n'
        exit 0 ;;
    off|revoke|--off)
        revoke
        exit 0 ;;
esac

MINUTES="${1:-15}"
[[ "$MINUTES" =~ ^[0-9]+$ ]] || die "MINUTES must be a whole number, got '$MINUTES'"
(( MINUTES >= 1 )) || die "MINUTES must be at least 1"
(( MINUTES <= MAX_MINUTES )) || die "MINUTES must be at most $MAX_MINUTES"

if (( EUID != 0 )); then
    exec sudo -- "$0" "$@"
fi

mkdir -p -- "$SUDOERS_DIR" "$STATE_DIR"
umask 077
cat > "$DROPIN" <<EOF
# Installed by \`kinetix sudo-passwordless $MINUTES\` for $CALLER.
# Temporary by construction: a timer removes it after $MINUTES minute(s),
# and kinetix-sudo-passwordless-cleanup removes it at boot if the machine
# restarts first. Do not edit by hand; do not remove the expiry.
Defaults:$CALLER timestamp_timeout=0
$CALLER ALL=(ALL:ALL) NOPASSWD: ALL
EOF
chmod 0440 "$DROPIN"

# Refuse to leave an invalid sudoers file behind. On failure the drop-in is
# removed so a bad grant cannot also break every other sudo call.
if ! visudo -c -f "$DROPIN" >/dev/null 2>&1; then
    rm -f -- "$DROPIN"
    die "generated sudoers file failed validation; not applying it"
fi

date -u +%FT%TZ > "$STATE_DIR/passwordless-since"

# Arm the revoke. A transient timer lives in systemd's runtime state, which
# is memory — it disappears on reboot, which is exactly why the boot cleanup
# service exists as well.
if command -v systemd-run >/dev/null 2>&1; then
    systemd-run --quiet --collect --unit=kinetix-passwordless-revoke \
        --on-active="${MINUTES}m" \
        "$0" off >/dev/null 2>&1 \
        || printf 'warning: could not arm the automatic revoke; run `kinetix sudo-passwordless off` manually\n' >&2
else
    printf 'warning: systemd-run unavailable; the grant will not auto-expire (revoke with `kinetix sudo-passwordless off`)\n' >&2
fi

printf 'Passwordless sudo granted to %s for %s minute(s).\n' "$CALLER" "$MINUTES"
printf 'Anything running as %s can now become root without a prompt.\n' "$CALLER"
printf 'It will be revoked automatically; `kinetix sudo-passwordless off` ends it early.\n'
