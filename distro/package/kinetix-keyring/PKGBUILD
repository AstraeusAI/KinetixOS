# Maintainer: KinetixOS
#
# Ships the KinetixOS package-signing public key and a pacman hook that
# populates it, so the [kinetix] repository can be verified with
# SigLevel = Required.
#
# kinetix.gpg, kinetix-trusted and kinetix-revoked are all generated by
# distro/setup-signing.sh — the trusted file has to carry the real key id, so
# it cannot be written by hand. Only the public keyring lands here; the private
# key never enters the repo.
#
# This package is the bootstrap: the ISO bakes the same key into
# /usr/share/pacman/keyrings and populates it at boot, so the very first
# `kinetix update` can verify the repo before this package exists on the
# target.
pkgname=kinetix-keyring
pkgver=0.1.0
pkgrel=1
pkgdesc="KinetixOS package signing keyring"
arch=('any')
url="https://github.com/AstraeusAI/KinetixOS"
license=('custom')
depends=('pacman')
source=()
sha256sums=()
install=kinetix-keyring.install

package() {
    local kr="$pkgdir/usr/share/pacman/keyrings"
    local f
    for f in kinetix.gpg kinetix-trusted kinetix-revoked; do
        if [[ ! -f "$startdir/$f" ]]; then
            printf 'kinetix-keyring: %s missing — run distro/setup-signing.sh\n' "$f" >&2
            return 1
        fi
    done
    install -d "$kr"
    install -m644 "$startdir/kinetix.gpg" "$kr/kinetix.gpg"
    install -m644 "$startdir/kinetix-trusted" "$kr/kinetix-trusted"
    install -m644 "$startdir/kinetix-revoked" "$kr/kinetix-revoked"
}
