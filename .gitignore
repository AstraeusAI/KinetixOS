__pycache__/
*.pyc
*.pyo
node_modules/
.DS_Store
*.swp
*.log

# Quickshell writes this as a symlink into a per-session runtime VFS path
# under /run/user/<uid>/... every time the shell starts — machine- and
# session-specific, not authored config (the real, portable qmlls config is
# the root-level .qmlls.ini).
/shell/.qmlls.ini

# Unrelated content that happens to live alongside this repo, not part of
# the argus-os project (see the commit that introduced this line).
/ KinetixOS/
/webos/
/New Folder/

# .opencode holds opencode customization. The skills and agents written for
# this project are versioned; everything else there (node_modules, the local
# package files, and skills that belong to unrelated work) stays local.
# Order matters: a directory must be un-ignored before anything inside it can
# be re-included, so `skills/` is opened and then narrowed to KinetixOS's own.
/.opencode/*
!/.opencode/agent/
!/.opencode/skills/
/.opencode/skills/*
!/.opencode/skills/kinetix-release/

# Reference corpus (third-party docs/examples pulled in for local research,
# not this project's code) and the eval harness (versioned candidate
# solutions + hidden grading probes — publishing it would leak the eval
# methodology and contaminate future runs of it). Neither belongs in the
# public repo. A stray pasted screenshot that landed in the repo root.
/CodeCorpus/
/kinetix-eval/
/b149aa09-3729-4f4f-b2c2-0b0a66569d3c.png

# KinetixOS build and packaging artefacts: the ISO output, the assembled
# pacman repo, the staged package tree, and the work/clone directories
# publish.sh creates. None are source; all are regenerated.
/distro/out/
/distro/package/kinetix/tree/
/distro/package/kinetix/pkg/
/distro/package/kinetix/src/
/distro/package/kinetix/*.pkg.tar.zst*
/distro/package/kinetix-keyring/pkg/
/distro/package/kinetix-keyring/src/
/distro/package/kinetix-keyring/*.pkg.tar.zst*
# The public signing keyring is generated by setup-signing.sh, not authored.
# Committing it would ship a key that goes stale on rotation and is meaningless
# before the key is created.
/distro/package/kinetix-keyring/kinetix.gpg
/distro/package/kinetix-keyring/kinetix-trusted
/distro/package/kinetix-keyring/kinetix-revoked
/distro/.publish/
